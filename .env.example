# Higgsfield 계정 연동용 자격 증명
#
# 발급: https://cloud.higgsfield.ai -> 대시보드 -> API / API Keys -> Create key
# KEY_ID 와 KEY_SECRET 은 생성 시 한 번만 표시되므로 바로 복사해 두세요.
#
# 이 파일을 .env 로 복사한 뒤 값을 채우면 됩니다:
#   cp .env.example .env

HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# 위 두 줄 대신 합쳐진 형태 한 줄만 써도 됩니다 (둘 다 있으면 이쪽이 우선):
# HIGGSFIELD_CREDENTIALS=KEY_ID:KEY_SECRET

# 기본값은 https://platform.higgsfield.ai 입니다. 보통 바꿀 필요 없습니다.
# HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# 단일 HTTP 요청 타임아웃 (ms)
# HIGGSFIELD_TIMEOUT_MS=60000
